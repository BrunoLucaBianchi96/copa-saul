# Local development (file-based SQLite)
DATABASE_URL=file:local.db

# Production (Turso)
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=your-auth-token

# Vercel Blob Storage (required for image uploads in production)
# Get this from: Vercel Dashboard > Project > Storage > Create Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Remove.bg API (optional, for automatic background removal)
# Get a free API key at: https://www.remove.bg/api
# REMOVE_BG_API_KEY=your-api-key
